# Template for the .env file that holds connection settings.
# Copy to .env for local runs. On a self-hosted runner, put these in the runner's own .env file.
# Never commit real values.

# Base address of the kiosk backend API (must end with /api/).
KIOSK_API_BASE_URL=http://<kiosk-api-host>:8090/api/
# Kiosk key, sent as the X-Kiosk-Key header (copy from kiosk.settings.json).
KIOSK_API_KEY=<kiosk key from kiosk.settings.json>
# Cinema the kiosk is configured for.
KIOSK_CINEMA_ID=0000000001
# Value sent in the "appversion" header, like the kiosk app does.
KIOSK_APP_VERSION=1.0.0
