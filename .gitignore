# Files and folders git must NOT upload.

# Installed npm packages (recreated with `npm ci`).
node_modules/
# Raw Playwright output from the last run.
test-results/
# Playwright HTML report of the last local run.
playwright-report/
# Dashboard built by local runs (`npm run dashboard`); published results live in reports/ instead.
dashboard/
# Dashboard folder built by the self-hosted runner job.
site/
# Secrets: API address and kiosk key. Never commit this file.
.env
